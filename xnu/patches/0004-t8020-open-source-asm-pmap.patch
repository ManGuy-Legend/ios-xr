diff --git a/osfmk/arm64/tunables/tunables.s b/osfmk/arm64/tunables/tunables.s
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/tunables/tunables.s
@@ -0,0 +1,8 @@
+/*
+ * T8020 stub: Apple's per-SoC CPU tunables (implementation-defined
+ * HID/ACC register settings applied by start.s) are not in the open
+ * source drop. Without them the CPU runs on reset defaults, which is
+ * correct enough for boot and early development.
+ */
+.macro APPLY_TUNABLES midr, tmp1, tmp2
+.endmacro
diff --git a/osfmk/arm64/ppl/sart.h b/osfmk/arm64/ppl/sart.h
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/ppl/sart.h
@@ -0,0 +1,14 @@
+/*
+ * T8020 stub: Apple's SART (System Address Region Table -- NVMe/ANS
+ * IOMMU) header is not in the open source drop. Bootstrap is a no-op;
+ * ANS storage access will need the real kext at runtime.
+ */
+#ifndef _ARM64_PPL_SART_H_
+#define _ARM64_PPL_SART_H_
+
+static inline void
+sart_bootstrap(void)
+{
+}
+
+#endif /* _ARM64_PPL_SART_H_ */
diff --git a/osfmk/arm64/ppl/uat.h b/osfmk/arm64/ppl/uat.h
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/ppl/uat.h
@@ -0,0 +1,14 @@
+/*
+ * T8020 stub: Apple's UAT (Unified Address Translator -- GPU page
+ * table manager) header is not in the open source drop. Bootstrap
+ * is a no-op; GPU access will need the real kext at runtime.
+ */
+#ifndef _ARM64_PPL_UAT_H_
+#define _ARM64_PPL_UAT_H_
+
