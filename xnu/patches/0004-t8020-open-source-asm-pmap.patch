+#endif /* _ARM64_PPL_UAT_H_ */
diff --git a/osfmk/arm64/machine_routines_apple.c b/osfmk/arm64/machine_routines_apple.c
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/machine_routines_apple.c
@@ -0,0 +1,8 @@
+/*
+ * T8020 stub: machine_routines_apple.c provides Apple Silicon-specific
+ * machine routine implementations. The KDK normally supplies it. With
+ * nos_arm_asm the build system expects the file to exist; the generic
+ * implementations in machine_routines.c suffice for boot.
+ */
+
+#include <arm/machine_routines.h>
