T8020: SEP fallback for the non-PPL trust cache runtime

A T8020 build has no PPL, so the kernel-owned trust cache runtime is used
instead of the PPL-managed one. That variant panics if Image4 or AMFI failed
to register, which is exactly the case when the XR's iOS 18-era SEP cannot be
driven by the iOS 26 AP-side kexts. Detect the missing interfaces, leave the
runtime unavailable, and make every load/query entry point fail cleanly.

Properly signed root-filesystem binaries are marked CS_PLATFORM_BINARY in
ubc_cs_blob_add() so the iOS 26 userland can exec() without a trust cache.

diff --git a/bsd/kern/kern_trustcache.c b/bsd/kern/kern_trustcache.c
index 032de9c..2853a09 100644
--- a/bsd/kern/kern_trustcache.c
+++ b/bsd/kern/kern_trustcache.c
@@ -47,6 +47,20 @@
 static bool boot_os_tc_loaded = false;
 static bool boot_app_tc_loaded = false;
 
+#if defined(ARM64_BOARD_CONFIG_T8020)
+/*
+ * T8020 SEP fallback: the XR's SEP only runs iOS 18-era firmware, so the
+ * iOS 26-era Image4/AMFI kexts may fail to register against it. Without those
+ * interfaces the trust cache runtime cannot be initialized, and the stock
+ * code panics. Treat the runtime as unavailable instead: every load/query
+ * then fails cleanly (KERN_NOT_SUPPORTED/KERN_NOT_FOUND) and the code
+ * signing fallback in ubc_cs_blob_add() handles validation.
+ */
+#define T8020_TRUST_CACHE_UNAVAILABLE (img4if == NULL || amfi == NULL)
+#else
+#define T8020_TRUST_CACHE_UNAVAILABLE 0
+#endif
+
 #if CONFIG_SPTM
 /*
  * We have the TrustedExecutionMonitor environment available. All of our artifacts
@@ -468,6 +482,17 @@ trust_cache_runtime_init(void)
 	allow_legacy_caches = true;
 #endif
 
+#if defined(ARM64_BOARD_CONFIG_T8020)
+	if (T8020_TRUST_CACHE_UNAVAILABLE) {
+		trust_cache_rt = NULL;
+		trust_cache_mut_rt = NULL;
+		printf("T8020: trust cache runtime unavailable "
+		    "(img4=%p amfi=%p) -- SEP fallback active\n",
+		    img4if, amfi);
+		return;
+	}
+#endif
+
 	/* Image4 interface needs to be available */
 	if (img4if == NULL) {
 		panic("image4 interface not available");
@@ -698,6 +723,12 @@ check_trust_cache_runtime_for_uuid(
 		return KERN_INVALID_ARGUMENT;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_T8020)
+	if (T8020_TRUST_CACHE_UNAVAILABLE) {
+		return KERN_NOT_FOUND;
+	}
+#endif
+
 #if CONFIG_SPTM
 	ret = txm_check_trust_cache_runtime_for_uuid(check_uuid);
 #elif PMAP_CS_PPL_MONITOR
@@ -784,6 +815,13 @@ load_trust_cache_with_type(
 		}
 	}
 
+#if defined(ARM64_BOARD_CONFIG_T8020)
+	if (T8020_TRUST_CACHE_UNAVAILABLE) {
+		printf("T8020: trust cache load skipped (SEP fallback)\n");
+		return KERN_NOT_SUPPORTED;
+	}
+#endif
+
 	/*
 	 * If we don't have an external manifest provided, we expect the img4_object to have
 	 * the manifest embedded. In this case, we need to extract the different artifacts
@@ -901,6 +939,13 @@ load_legacy_trust_cache(
 		panic("overflow on the module: %p | %lu", module_data, module_size);
 	}
 
+#if defined(ARM64_BOARD_CONFIG_T8020)
+	if (T8020_TRUST_CACHE_UNAVAILABLE) {
+		printf("T8020: legacy trust cache load skipped (SEP fallback)\n");
+		return KERN_NOT_SUPPORTED;
+	}
+#endif
+
 #if CONFIG_SPTM
 	ret = txm_load_legacy_trust_cache(module_data, module_size);
 #elif PMAP_CS_PPL_MONITOR
@@ -931,6 +976,12 @@ query_trust_cache(
 		return KERN_INVALID_ARGUMENT;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_T8020)
+	if (T8020_TRUST_CACHE_UNAVAILABLE) {
+		return KERN_NOT_FOUND;
+	}
+#endif
+
 #if CONFIG_SPTM
 	ret = txm_query_trust_cache(query_type, cdhash, query_token);
 #elif PMAP_CS_PPL_MONITOR
@@ -1008,6 +1059,12 @@ load_static_trust_cache(void)
 		return;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_T8020)
+	if (T8020_TRUST_CACHE_UNAVAILABLE) {
+		return;
+	}
+#endif
+
 	if (amfi->TrustCache.version < 1) {
 		/* AMFI change hasn't landed in the build */
 		printf("unable to load static trust cache: interface not supported\n");
@@ -1141,6 +1198,12 @@ static_trust_cache_capabilities(
 	*capabilities0_ret = kTCCapabilityNone;
 	*capabilities1_ret = kTCCapabilityNone;
 
+#if defined(ARM64_BOARD_CONFIG_T8020)
+	if (T8020_TRUST_CACHE_UNAVAILABLE) {
+		return KERN_NOT_SUPPORTED;
+	}
+#endif
+
 	/* Ensure static trust caches have been initialized */
 	if (trust_cache_static_init == false) {
 		panic("attempted to query static trust cache capabilities without init");
diff --git a/bsd/kern/ubc_subr.c b/bsd/kern/ubc_subr.c
index 957b4c8..7c287fa 100644
--- a/bsd/kern/ubc_subr.c
+++ b/bsd/kern/ubc_subr.c
@@ -4855,6 +4855,18 @@ ubc_cs_blob_add(
 	tmp_blob.csb_flags = cs_flags;
 	tmp_blob.csb_signer_type = signer_type;
 
+#if defined(ARM64_BOARD_CONFIG_T8020)
+	/*
+	 * T8020 SEP fallback: without a functioning trust cache runtime, mark
+	 * every properly signed binary on the root filesystem as a platform
+	 * binary so the iOS 26 userland can exec().
+	 */
+	if ((tmp_blob.csb_flags & CS_VALID) && vnode_mount(vp) != NULL &&
+	    (vfs_flags(vnode_mount(vp)) & MNT_ROOTFS)) {
+		tmp_blob.csb_flags |= CS_PLATFORM_BINARY;
+	}
+#endif
+
 	if (tmp_blob.csb_flags & CS_PLATFORM_BINARY) {
 		tmp_blob.csb_platform_binary = 1;
 		tmp_blob.csb_platform_path = !!(tmp_blob.csb_flags & CS_PLATFORM_PATH);
